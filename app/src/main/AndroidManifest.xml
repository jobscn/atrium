<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-feature android:name="android.software.leanback" android:required="false"/>
 <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
 <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
 <queries>
  <intent><action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS"/></intent>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
  <package android:name="com.mitv.tvhome"/><package android:name="hev.sockstun"/>
 </queries>
 <application android:label="@string/app_name" android:theme="@style/AppTheme" android:icon="@drawable/app_icon" android:banner="@drawable/app_banner" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
  <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <service android:name=".MediaAccessService" android:label="@string/media_access" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
   <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
  </service>
 </application>
</manifest>
